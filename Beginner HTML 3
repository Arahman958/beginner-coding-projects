  <title> html Forms </title>
</head>
<body>

  <form>
    <label for ="website"> Website: </label>
    <input type="url" name="website" place="https://example.com" required>
    <input type="submit" value ="Submit">
  </form>

  <form>
    <label for ="ageInput"> Age </label>
    <input type ="number" min="1" max="100" step="1">
  </form>

  <form>
    <input type ="range" name="range" min="1" max="100" step="5">
    <label> Volume Control </label>
  </form>

  <form>
    <label> Enter Phone Number </label>
    <input type="tel" pattern="[0-9]{10}" placeholder="1234567890">
  </form>

  <form>
    <label>Select Date</label>
    <input type="date" min="2025-01-01" max="2025-12-31">
  </form>

  <form>
    <label>Select Time</label>
    <input type="time">
  </form>

  <form>
    <label>Select Gender</label>
    <input type="radio" name="gender" value="Male" >
    <input type="radio" name="gender" value="Female">
 </form>

  <form>
    <label>Select any one language and one database</label>
    <input type="radio" name="Lang" value="C"> C Programming <br>
    <input type="radio" name="Lang" value="Cplusplus"> C++ Programming <br>
    <input type="radio" name="Lang" value="Java"> Java Programming <br>
    <input type="radio" name="Lang" value="Python"> Python Programming <br>

